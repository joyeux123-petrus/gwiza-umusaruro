    <style>
        .wc-dose-table-wrapper {
            width: 100%;
            overflow-x: auto;
        }

        .wc-dose-table-controls {
            display: flex;
            justify-content: flex-end;
            align-items: center;
            margin-bottom: 16px;
            font-size: 18px;
            font-weight: 700;
            color: #4b5563;
        }

        .wc-dose-table-controls label {
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .wc-dose-table-search {
            width: 260px;
            border: none;
            border-bottom: 1px solid #bdbdbd;
            padding: 8px 4px;
            font-size: 18px;
            outline: none;
            background: transparent;
        }

        .wc-dose-table-search:focus {
            border-bottom-color: #198754;
        }

        .wc-dose-table {
            width: 100%;
            border-collapse: collapse;
            font-size: 18px;
        }

        .wc-dose-table th {
            background: #d9a313;
            color: #ffffff;
            text-align: left;
            padding: 14px 22px;
            font-weight: 700;
        }

        .wc-dose-table td {
            padding: 13px 22px;
            border-bottom: 1px solid #e5e5e5;
            color: #000000;
        }

        .wc-dose-table tbody tr:nth-child(odd):not(.wc-dose-no-results) {
            background: #f4f4f4;
        }

        .wc-dose-table tbody tr:nth-child(even):not(.wc-dose-no-results) {
            background: #fbf5e8;
        }

        .wc-dose-table a {
            color: #198754;
            font-weight: 700;
            text-decoration: none;
        }

        .wc-dose-table a:hover {
            text-decoration: underline;
        }

        .wc-dose-no-results td {
            text-align: center;
            font-weight: 600;
            color: #666666;
            background: #f4f4f4;
        }

        @media (max-width: 768px) {
            .wc-dose-table-controls {
                justify-content: flex-start;
                font-size: 16px;
            }

            .wc-dose-table-controls label {
                width: 100%;
            }

            .wc-dose-table-search {
                width: 100%;
                max-width: 260px;
                font-size: 16px;
            }

            .wc-dose-table {
                font-size: 15px;
                min-width: 680px;
            }

            .wc-dose-table th,
            .wc-dose-table td {
                padding: 11px 14px;
            }
        }
    </style>
    
